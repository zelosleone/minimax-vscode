{
  "name": "minimax-vscode",
  "displayName": "MiniMax (coding)",
  "description": "Language model provider for GitHub Copilot in VS Code: use MiniMax text models for programming with a Token Plan API key. Does not add speech, video, or image generation APIs.",
  "version": "1.6.3",
  "publisher": "denizhandaklr",
  "license": "MIT",
  "icon": "icon/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelosleone/minimax-vscode"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.111.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ai",
    "minimax",
    "minimax m2.7",
    "token plan",
    "language model",
    "github copilot",
    "chat",
    "coding"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:minimax"
  ],
  "enabledApiProposals": [
    "languageModelThinkingPart"
  ],
  "contributes": {
    "commands": [
      {
        "command": "minimax.switchToGlobal",
        "title": "MiniMax: Switch to Global API (minimax.io)"
      },
      {
        "command": "minimax.switchToChina",
        "title": "MiniMax: Switch to Chinese API (minimaxi.com)"
      }
    ],
    "configuration": {
      "title": "MiniMax",
      "properties": {
        "minimax.apiBaseUrl": {
          "type": "string",
          "default": "https://api.minimax.io/v1",
          "scope": "application",
          "markdownDescription": "MiniMax API base URL. Use `https://api.minimax.io/v1` for international users or `https://api.minimaxi.com/v1` for users in China. Must end with `/v1`."
        },
        "minimax.visibleModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "uniqueItems": true,
          "scope": "application",
          "markdownDescription": "Live MiniMax model ids to show in the picker (from GET {baseUrl}/models). Empty means show every live model."
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "minimax",
        "displayName": "MiniMax",
        "configuration": {
          "type": "object",
          "properties": {
            "apiKey": {
              "type": "string",
              "secret": true,
              "title": "API key",
              "description": "MiniMax Token Plan API key from platform.minimax.io (Account / Token Plan)."
            }
          },
          "required": [
            "apiKey"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ --noEmit",
    "build": "node esbuild.mjs --production",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc -p ./ --noEmit --watch",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "openai": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.111.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
